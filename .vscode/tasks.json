{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/OnvifLib.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "rebuild",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/OnvifLib.sln",
                "--no-incremental",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            // Packs the library only. The samples set IsPackable=false, but naming the project
            // keeps the release artifact independent of that.
            "label": "pack",
            "command": "dotnet",
            "type": "process",
            "args": [
                "pack",
                "${workspaceFolder}/OnvifLib.csproj",
                "-c",
                "Release",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/OnvifLib.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish gui win-x64",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/samples/OnvifLib.Gui/OnvifLib.Gui.csproj",
                "-c",
                "Release",
                "-r",
                "win-x64",
                "--self-contained",
                "-o",
                "${workspaceFolder}/artifacts/OnvifLib.Gui-win-x64",
                "-p:PublishSingleFile=false",
                "-p:DebugType=None",
                "-p:DebugSymbols=false"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            // Harvests artifacts/OnvifLib.Gui-win-x64 into an MSI. Windows only; publish first.
            "label": "msi",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/samples/OnvifLib.Gui.Setup/OnvifLib.Gui.Setup.wixproj",
                "-c",
                "Release",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "dependsOn": ["publish gui win-x64"],
            "problemMatcher": "$msCompile"
        },
        {
            // Loads every GUI view and fails if any of them does not construct. A TabControl only
            // realises the selected tab, so this is what catches a XAML error in a tab nobody
            // clicked. Cheap enough to run after touching any .axaml.
            "label": "gui self-test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/samples/OnvifLib.Gui/OnvifLib.Gui.csproj",
                "--",
                "--selftest"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
