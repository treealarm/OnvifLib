        "ONVIF_PASSWORD": ""
      }
    },
    "reversible writes": {
      "commandName": "Project",
      "commandLineArgs": "--allow-writes",
      "environmentVariables": {
        "ONVIF_IP": "192.168.1.10",
        "ONVIF_PORT": "80",
        "ONVIF_USER": "admin",
        "ONVIF_PASSWORD": ""
      }
    }
  }
