<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OnvifLib.Gui.ViewModels"
             xmlns:views="using:OnvifLib.Gui.Views"
             x:Class="OnvifLib.Gui.Views.MediaView"
             x:DataType="vm:MediaViewModel">

  <Panel Margin="8">

    <Border Classes="banner" VerticalAlignment="Top" IsVisible="{Binding !IsAvailable}">
      <TextBlock Classes="hint" Text="{Binding UnavailableReason}" />
    </Border>

    <TabControl IsVisible="{Binding IsAvailable}">

      <TabItem Header="Streams">
        <Grid ColumnDefinitions="*,8,1.2*" Margin="0,4,0,0">
          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
              <TextBlock Classes="section" Text="Profiles" VerticalAlignment="Center" Margin="0" />
              <Button Content="Refresh" Command="{Binding RefreshProfilesCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
              <TextBlock Classes="section" Text="Stream URI" Margin="0,0,0,0" />
              <Button Content="Get stream URI" Command="{Binding GetStreamUriCommand}"
                      IsEnabled="{Binding HasProfile}" HorizontalAlignment="Left" />
              <TextBox Text="{Binding StreamUri, Mode=OneWay}" IsReadOnly="True" Classes="mono"
                       TextWrapping="Wrap" MaxHeight="56" />
              <SelectableTextBlock Text="{Binding MaskedStreamUri}" Classes="mono" TextWrapping="Wrap" MaxLines="2" />
              <WrapPanel>
                <Button Content="Copy URI" Click="OnCopyStreamUri" Margin="0,0,8,4"
                        ToolTip.Tip="Copies the real URI, with the password in clear text." />
                <Button Content="Play externally" Command="{Binding PlayStreamCommand}" Margin="0,0,8,4" />
                <ComboBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}"
                          Width="160" Margin="0,0,8,4" PlaceholderText="no player found" />
              </WrapPanel>
              <TextBox Text="{Binding CustomPlayerPath}" Watermark="…or a player executable path" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                      IsReadOnly="True" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="W" Binding="{Binding Width}" Width="Auto" />
                <DataGridTextColumn Header="H" Binding="{Binding Height}" Width="Auto" />
                <DataGridTextColumn Header="Codec" Binding="{Binding Encoding}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>

          <Border Grid.Column="2" BorderBrush="#33808080" BorderThickness="1">
            <views:VideoView DataContext="{Binding Video}" />
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Snapshot">
        <DockPanel Margin="0,4,0,0">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,4">
            <TextBlock Classes="hint"
                       Text="Snapshot uses the camera's first profile. Paste another JPEG URL below if needed." />
            <WrapPanel>
              <Button Content="Snapshot" Command="{Binding SnapshotCommand}" Margin="0,0,8,4" />
              <ToggleButton Content="Live" IsChecked="{Binding IsLive}" Command="{Binding ToggleLiveCommand}"
                            Margin="0,0,8,4" />
              <NumericUpDown Value="{Binding SnapshotIntervalMs}" Minimum="100" Maximum="10000"
                             Increment="100" FormatString="0" Width="120" Margin="0,0,8,4" />
              <Button Content="Save…" Click="OnSaveSnapshot" Margin="0,0,8,4" />
            </WrapPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBox Text="{Binding ManualSnapshotUrl}" Watermark="snapshot URL to fetch directly" Width="360" />
            <Button Content="Download" Command="{Binding DownloadSnapshotCommand}" />
            <TextBlock Text="{Binding SnapshotInfo}" Classes="hint" VerticalAlignment="Center" />
          </StackPanel>
          <Border BorderBrush="#33808080" BorderThickness="1">
            <Image Source="{Binding Frame}" Stretch="Uniform" />
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Encoders">
        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
              <TextBlock Classes="section" Text="Video" VerticalAlignment="Center" Margin="0" />
              <Button Content="Load configs" Command="{Binding LoadVideoConfigsCommand}" />
              <Button Content="Load options" Command="{Binding LoadVideoOptionsCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
              <WrapPanel>
                <NumericUpDown Value="{Binding EditWidth}" FormatString="0" Width="100" Margin="0,0,4,4" />
                <NumericUpDown Value="{Binding EditHeight}" FormatString="0" Width="100" Margin="0,0,4,4" />
                <NumericUpDown Value="{Binding EditFrameRate}" FormatString="0" Width="90" Margin="0,0,4,4" />
                <NumericUpDown Value="{Binding EditBitrate}" FormatString="0" Width="100" Margin="0,0,4,4" />
                <NumericUpDown Value="{Binding EditGovLength}" FormatString="0" Width="90" Margin="0,0,4,4" />
                <Button Content="Apply" Command="{Binding ApplyVideoConfigCommand}" />
              </WrapPanel>
              <TextBlock Classes="hint" Text="Width, height, fps, bitrate, GOV." />
            </StackPanel>
            <Grid RowDefinitions="*,4,*">
              <DataGrid Grid.Row="0" ItemsSource="{Binding VideoConfigs}" SelectedItem="{Binding SelectedVideoConfig}"
                        IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="Codec" Binding="{Binding Encoding}" Width="Auto" />
                  <DataGridTextColumn Header="W" Binding="{Binding Width}" Width="Auto" />
                  <DataGridTextColumn Header="H" Binding="{Binding Height}" Width="Auto" />
                  <DataGridTextColumn Header="fps" Binding="{Binding FrameRateLimit}" Width="Auto" />
                  <DataGridTextColumn Header="kbps" Binding="{Binding BitrateLimit}" Width="Auto" />
                  <DataGridTextColumn Header="GOV" Binding="{Binding GovLength}" Width="Auto" />
                </DataGrid.Columns>
              </DataGrid>
              <DataGrid Grid.Row="2" ItemsSource="{Binding VideoOptions}" IsReadOnly="True"
                        GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Codec" Binding="{Binding Encoding}" Width="Auto" />
                  <DataGridTextColumn Header="fps" Binding="{Binding MinFrameRate, StringFormat='from {0}'}" Width="Auto" />
                  <DataGridTextColumn Header="max fps" Binding="{Binding MaxFrameRate}" Width="Auto" />
                  <DataGridTextColumn Header="min kbps" Binding="{Binding MinBitrate}" Width="Auto" />
                  <DataGridTextColumn Header="max kbps" Binding="{Binding MaxBitrate}" Width="Auto" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </DockPanel>

          <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
              <TextBlock Classes="section" Text="Audio" VerticalAlignment="Center" Margin="0" />
              <Button Content="Load configs" Command="{Binding LoadAudioConfigsCommand}" />
              <Button Content="Load options" Command="{Binding LoadAudioOptionsCommand}" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding AudioConfigs}" SelectedItem="{Binding SelectedAudioConfig}"
                      IsReadOnly="True" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Codec" Binding="{Binding Encoding}" Width="Auto" />
                <DataGridTextColumn Header="kbps" Binding="{Binding Bitrate}" Width="Auto" />
                <DataGridTextColumn Header="Hz" Binding="{Binding SampleRate}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Profile M">
        <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="section" Text="Metadata" VerticalAlignment="Center" Margin="0" />
                <Button Content="Load" Command="{Binding LoadMetadataConfigsCommand}" />
                <Button Content="Options" Command="{Binding LoadMetadataOptionsCommand}" />
              </StackPanel>
              <TextBlock Classes="hint" Text="{Binding MetadataOptionsText}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox Content="Analytics" IsChecked="{Binding EditAnalytics}" IsThreeState="True" />
                <CheckBox Content="PTZ status" IsChecked="{Binding EditPtzStatus}" IsThreeState="True" />
                <Button Content="Apply" Command="{Binding ApplyMetadataConfigCommand}" />
              </StackPanel>
              <WrapPanel>
                <Button Content="Attach to profile" Command="{Binding AttachMetadataCommand}" Margin="0,0,8,4" />
                <Button Content="Detach" Command="{Binding DetachMetadataCommand}" Margin="0,0,8,4" />
              </WrapPanel>
            </StackPanel>
            <DataGrid ItemsSource="{Binding MetadataConfigs}" SelectedItem="{Binding SelectedMetadataConfig}"
                      IsReadOnly="True" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridCheckBoxColumn Header="Analytics" Binding="{Binding Analytics}" Width="Auto" />
                <DataGridCheckBoxColumn Header="PTZ" Binding="{Binding PtzStatus}" Width="Auto" />
                <DataGridCheckBoxColumn Header="Events" Binding="{Binding Events}" Width="Auto" />
                <DataGridTextColumn Header="Profiles" Binding="{Binding AttachedProfileTokens.Count}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>

          <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
              <TextBlock Classes="section" Text="Analytics configs" VerticalAlignment="Center" Margin="0" />
              <Button Content="Load" Command="{Binding LoadAnalyticsConfigsCommand}" />
            </StackPanel>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button Content="Attach to profile" Command="{Binding AttachAnalyticsCommand}" Margin="0,0,8,4" />
              <Button Content="Detach" Command="{Binding DetachAnalyticsCommand}" Margin="0,0,8,4" />
            </WrapPanel>
            <DataGrid ItemsSource="{Binding AnalyticsConfigs}" SelectedItem="{Binding SelectedAnalyticsConfig}"
                      IsReadOnly="True" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Profiles" Binding="{Binding AttachedProfileTokens.Count}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Grid>
      </TabItem>

    </TabControl>
  </Panel>
</UserControl>
