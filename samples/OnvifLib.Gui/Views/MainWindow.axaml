<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OnvifLib.Gui.ViewModels"
        xmlns:views="using:OnvifLib.Gui.Views"
        xmlns:inf="using:OnvifLib.Gui.Infrastructure"
        x:Class="OnvifLib.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.png"
        Title="OnvifLib"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="640">

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#33808080">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="Timeout" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="120" Increment="1"
                       FormatString="0" Width="100"
                       ToolTip.Tip="How long to wait for the camera to answer, in seconds." />

        <CheckBox IsChecked="{Binding CaptureSoap}" Content="Capture SOAP"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Passing a logger to Camera.Create is what turns on the SOAP dump, and it cannot be changed afterwards — this takes effect on the next login." />

        <CheckBox IsChecked="{Binding AutoPlayLive}" Content="Auto-play live"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Start in-window video (substream) when a connected device is selected." />
      </StackPanel>
    </Border>

    <Grid DockPanel.Dock="Bottom" RowDefinitions="Auto,4,72">
      <Border Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="#33808080">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Runner.Status}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     Classes.error="{Binding Runner.StatusIsError}" />
          <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="4" Margin="12,0"
                       IsVisible="{Binding Runner.IsBusy}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding ConnectionText}" Opacity="0.7"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
      <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" />
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="8,4,8,0" Text="Activity" />
        <ListBox x:Name="ActivityList" ItemsSource="{Binding Runner.Activity}"
                 BorderThickness="0" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="inf:ActivityEntry">
              <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                         Classes.mono="True" Classes.error="{Binding IsError}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>

    <Grid ColumnDefinitions="340,1,*">

      <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#33808080">
        <views:DeviceListView DataContext="{Binding Devices}" />
      </Border>

      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

      <!-- Tabs. Deliberately never disabled: a tab the camera cannot support still opens and
           explains why, because "this camera has no PTZ" is exactly what a test bench is for. -->
      <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="Live">
          <views:VideoView Margin="8" DataContext="{Binding Video}" />
        </TabItem>
        <TabItem Header="Device">
          <views:DeviceView DataContext="{Binding Device}" />
        </TabItem>
        <TabItem Header="Media">
          <views:MediaView DataContext="{Binding Media}" />
        </TabItem>
        <TabItem Header="PTZ">
          <views:PtzView DataContext="{Binding Ptz}" />
        </TabItem>
        <TabItem Header="Imaging">
          <views:ImagingView DataContext="{Binding Imaging}" />
        </TabItem>
        <TabItem Header="Events">
          <views:EventsView DataContext="{Binding Events}" />
        </TabItem>
        <TabItem Header="Analytics">
          <views:AnalyticsView DataContext="{Binding Analytics}" />
        </TabItem>
        <TabItem Header="Profile G">
          <views:RecordingView DataContext="{Binding Recording}" />
        </TabItem>
        <TabItem Header="Device I/O">
          <views:DeviceIoView DataContext="{Binding DeviceIo}" />
        </TabItem>
        <TabItem Header="Discovery">
          <views:DiscoveryView DataContext="{Binding Discovery}" />
        </TabItem>
        <TabItem Header="Log">
          <views:LogView DataContext="{Binding Log}" />
        </TabItem>
      </TabControl>

    </Grid>

  </DockPanel>
</Window>
