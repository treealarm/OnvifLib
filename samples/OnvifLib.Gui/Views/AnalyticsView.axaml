<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OnvifLib.Gui.ViewModels"
             xmlns:onvif="using:OnvifLib"
             x:Class="OnvifLib.Gui.Views.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel">

  <Panel Margin="8">

    <Border Classes="banner" VerticalAlignment="Top" IsVisible="{Binding !IsAvailable}">
      <TextBlock Classes="hint" Text="{Binding UnavailableReason}" />
    </Border>

    <DockPanel IsVisible="{Binding IsAvailable}">

      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
        <TextBlock Text="Configuration" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Configurations}" SelectedItem="{Binding SelectedConfiguration}"
                  Width="240" PlaceholderText="load configurations…">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="onvif:OnvifAnalyticsConfig">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Load configurations" Command="{Binding LoadConfigurationsCommand}" />
      </StackPanel>

      <TabControl>
        <TabItem Header="Modules">
          <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Classes="section" Text="Supported" Margin="0,0,0,4" />
              <DataGrid ItemsSource="{Binding SupportedModules}"
                        SelectedItem="{Binding SelectedSupportedModule}" IsReadOnly="True"
                        GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                  <DataGridTextColumn Header="Max" Binding="{Binding MaxInstances}" Width="Auto" />
                  <DataGridTextColumn Header="Params" Binding="{Binding Parameters.Count}" Width="Auto" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Classes="section" Text="Running" Margin="0,0,0,4" />
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Content="Apply edits" Command="{Binding ApplyModuleCommand}" />
                <Button Content="Delete" Command="{Binding DeleteModuleCommand}" />
                <Button Content="Reload" Command="{Binding LoadModulesCommand}" />
              </StackPanel>
              <DataGrid ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}"
                        IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" />
                  <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Rules">
          <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Classes="section" Text="Supported" Margin="0,0,0,4" />
              <DataGrid ItemsSource="{Binding SupportedRules}"
                        SelectedItem="{Binding SelectedSupportedRule}" IsReadOnly="True"
                        GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                  <DataGridTextColumn Header="Max" Binding="{Binding MaxInstances}" Width="Auto" />
                  <DataGridTextColumn Header="Cells" Binding="{Binding CellLayout}" Width="Auto" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Classes="section" Text="Running" Margin="0,0,0,4" />
              <Button DockPanel.Dock="Bottom" Content="Reload" Command="{Binding LoadRulesCommand}"
                      HorizontalAlignment="Left" Margin="0,4,0,0" />
              <DataGrid ItemsSource="{Binding Rules}" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" />
                  <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Parameters">
          <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Classes="section" Text="Simple (editable)" Margin="0,0,0,4" />
              <DataGrid ItemsSource="{Binding SelectedItems}"
                        GridLinesVisibility="Horizontal" CanUserSortColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" IsReadOnly="True" />
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Classes="section" Text="Structured / raw XML" Margin="0,0,0,4" />
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                <Button Content="Module options" Command="{Binding LoadModuleOptionsXmlCommand}" />
                <Button Content="Rule options" Command="{Binding LoadRuleOptionsXmlCommand}" />
                <Button Content="Supported rules" Command="{Binding LoadSupportedRulesXmlCommand}" />
              </StackPanel>
              <Grid RowDefinitions="*,4,*">
                <TextBox Grid.Row="0" Classes="mono" IsReadOnly="True" AcceptsReturn="True"
                         Text="{Binding StructuredXml, Mode=OneWay}" />
                <TextBox Grid.Row="2" Classes="mono" IsReadOnly="True" AcceptsReturn="True"
                         Text="{Binding RawXml, Mode=OneWay}" />
              </Grid>
            </DockPanel>
          </Grid>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Panel>
</UserControl>
