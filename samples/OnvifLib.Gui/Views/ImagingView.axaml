<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OnvifLib.Gui.ViewModels"
             x:Class="OnvifLib.Gui.Views.ImagingView"
             x:DataType="vm:ImagingViewModel">

  <Panel Margin="8">

    <Border Classes="banner" VerticalAlignment="Top" IsVisible="{Binding !IsAvailable}">
      <TextBlock Classes="hint" Text="{Binding UnavailableReason}" />
    </Border>

    <StackPanel IsVisible="{Binding IsAvailable}" Spacing="6" MaxWidth="700" HorizontalAlignment="Left">

      <TextBlock Classes="section" Text="Picture" />
      <TextBlock Classes="hint" Text="{Binding SourceLabel}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Reload" Command="{Binding LoadSettingsCommand}"
                ToolTip.Tip="Read the current values from the camera again." />
        <Button Content="Apply ticked" Command="{Binding ApplyCommand}" />
      </StackPanel>
      <TextBlock Classes="hint" Text="{Binding StatusText}" />

      <TextBlock Classes="section" Text="Settings" />
      <TextBlock Classes="hint"
                 Text="Only ticked settings are sent. The library treats an omitted value as &quot;leave unchanged&quot; and does its own read-modify-write, so re-sending everything would be a way to overwrite something you never meant to touch." />

      <Grid ColumnDefinitions="Auto,120,*,90" RowDefinitions="Auto,Auto,Auto,Auto" >
        <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding ChangeBrightness}" IsEnabled="{Binding HasBrightness}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Brightness" VerticalAlignment="Center" />
        <Slider Grid.Row="0" Grid.Column="2" Value="{Binding Brightness}"
                Minimum="{Binding BrightnessMin}" Maximum="{Binding BrightnessMax}" IsEnabled="{Binding HasBrightness}" />
        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Brightness, StringFormat='{}{0:0.##}'}" VerticalAlignment="Center" />

        <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding ChangeContrast}" IsEnabled="{Binding HasContrast}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Contrast" VerticalAlignment="Center" />
        <Slider Grid.Row="1" Grid.Column="2" Value="{Binding Contrast}"
                Minimum="{Binding ContrastMin}" Maximum="{Binding ContrastMax}" IsEnabled="{Binding HasContrast}" />
        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Contrast, StringFormat='{}{0:0.##}'}" VerticalAlignment="Center" />

        <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding ChangeSaturation}" IsEnabled="{Binding HasSaturation}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="Colour saturation" VerticalAlignment="Center" />
        <Slider Grid.Row="2" Grid.Column="2" Value="{Binding Saturation}"
                Minimum="{Binding SaturationMin}" Maximum="{Binding SaturationMax}" IsEnabled="{Binding HasSaturation}" />
        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Saturation, StringFormat='{}{0:0.##}'}" VerticalAlignment="Center" />

        <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding ChangeSharpness}" IsEnabled="{Binding HasSharpness}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="Sharpness" VerticalAlignment="Center" />
        <Slider Grid.Row="3" Grid.Column="2" Value="{Binding Sharpness}"
                Minimum="{Binding SharpnessMin}" Maximum="{Binding SharpnessMax}" IsEnabled="{Binding HasSharpness}" />
        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Sharpness, StringFormat='{}{0:0.##}'}" VerticalAlignment="Center" />
      </Grid>

      <TextBlock Classes="hint"
                 Text="A disabled row means the camera reported no range for that setting. Turn on the live snapshot on the Media tab to watch a change take effect." />

    </StackPanel>
  </Panel>
</UserControl>
