<Project>
  <!--
    Pinned BtbN LGPL win-x64 build for local Windows publish and MSI builds. Keep it equal to
    the win-x64 ffmpeg_url / ffmpeg_sha in .github/workflows/release-gui.yml: BtbN deletes dated
    autobuilds after about two weeks, so both are repinned together.
    The archive is not committed; the MSI / publish output fetch it at pack time.
  -->
  <PropertyGroup>
    <FfmpegWinX64Url>https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-10-12-13-12/ffmpeg-n8.1.3-18-g46d899d7a0-win64-lgpl-8.1.zip</FfmpegWinX64Url>
    <FfmpegWinX64Sha256>fa6c5563a794a4dc98cb521e7aad1526004149d308f99ff0ca30159b1451c522</FfmpegWinX64Sha256>
  </PropertyGroup>
</Project>
