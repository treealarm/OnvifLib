<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

    <PackageId>OnvifLib</PackageId>
    <Version>1.3.1</Version>
    <Authors>Danil Serov</Authors>
    <Company>TreeAlarm</Company>
    <Copyright>Copyright (c) TreeAlarm</Copyright>
    <Description>A modern .NET library for ONVIF-compliant IP cameras: device discovery, media profiles and RTSP URIs, OSD, PTZ with home and auxiliary commands, imaging with exposure, white balance, day/night and focus control, events (PullPoint with topic filters), device administration (users, network, NTP/DNS, time zone, scopes), analytics modules and rules with Profile M metadata, Profile G edge recordings, jobs and event search, and device I/O.</Description>
    <!-- Terms someone would actually search nuget.org for, not a restatement of the title. -->
    <PackageTags>onvif;ip-camera;cctv;video-surveillance;ptz;rtsp;discovery;ws-discovery;profile-g;profile-m;analytics;soap</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>1.3.1: Pull points are released, not abandoned. EventService1 gains DisposeAsync (Dispose does the same for synchronous callers): it stops the receive loop, waits for it, unsubscribes over the still-open subscription manager with a bounded deadline, and only then closes the clients. The old order closed the clients under the loop, so its Unsubscribe was lost and the camera kept the pull point — a camera with a small MaxPullPoints ran out after a series of restarts and then refused every new subscription. Re-subscribing now releases the old pull point first on both paths, including after a fault, so a camera at its cap frees a slot instead of losing the subscription for good. StopReceivingAsync now stops deterministically, and a refused CreatePullPointSubscription logs the camera's advertised MaxPullPoints. 1.3.0: Geolocation on Camera — GetGeoLocationAsync and SetGeoLocationAsync, with the ONVIF *Specified flags honoured so a coordinate the camera did not report is absent rather than zero. Device I/O live state: DeviceIoStateWatcher opens a topic-filtered pull point on Device/Trigger/Relay and Device/Trigger/DigitalInput, where the Initialized snapshot gives each relay's and input's current state and Changed gives every update, and keeps it as a TryGetState snapshot with a change event. DeviceIoState carries a relay's logical state and contact. The probe gains geolocation steps and shows live relay and input state. New unit tests project (not packaged).</PackageReleaseNotes>

    <!-- XML docs ship with the package so consumers get IntelliSense on the public API. CS1591
         ("missing XML comment") is suppressed rather than chased: most of the public surface is
         svcutil-generated Reference.cs, which carries no docs and is not ours to annotate. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- A build from a clean checkout produces byte-identical output, which is what lets SourceLink
         point at sources that provably match the binary. -->
    <Deterministic>true</Deterministic>
    <!-- RepositoryUrl+RepositoryType put the "Source repository" link (with the exact commit) on
         the nuget.org page; PackageProjectUrl is the separate "Project website" link at the top. -->
    <PackageProjectUrl>https://github.com/treealarm/OnvifLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/treealarm/OnvifLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink: lets a consumer step into this library's sources from their debugger instead of
         only following a link. The .NET 10 SDK ships the GitHub provider, so no package reference is
         needed — these switches are the whole setup. The symbol package travels with the .nupkg:
         `dotnet nuget push` picks up a matching .snupkg sitting next to it. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="System.ServiceModel.Duplex" Version="6.0.*" />
    <PackageReference Include="System.ServiceModel.Federation" Version="10.*" />
    <PackageReference Include="System.ServiceModel.Http" Version="10.*" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="10.*" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="10.*" />
    <PackageReference Include="System.ServiceModel.Security" Version="6.0.*" />
    <!-- Transitive through System.ServiceModel.*, which still asks for 10.0.0 — a version NuGet
         audit flags with known high-severity advisories. Pinned here so the restored graph gets
         the patched build (10.0.13 also brings System.Security.Cryptography.Pkcs 10.0.13, the fix
         for the 2026-10-13 advisories on both); drop this line once the WCF packages ask for it
         themselves. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <!-- This project sits at the repository root, so the SDK's default **/*.cs glob would
         compile the sample applications and the tests into the library itself. They are
         separate projects with their own csproj files and must stay out. -->
    <Compile Remove="samples/**" />
    <None Remove="samples/**" />
    <EmbeddedResource Remove="samples/**" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mapper's *Specified handling and the event parser are internal, tested directly. -->
    <InternalsVisibleTo Include="OnvifLib.Tests" />
  </ItemGroup>
</Project>