<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

    <PackageId>OnvifLib</PackageId>
    <Version>1.0.10</Version>
    <Authors>Danil Serov</Authors>
    <Company>TreeAlarm</Company>
    <Copyright>Copyright (c) TreeAlarm</Copyright>
    <Description>A modern .NET library for ONVIF-compliant IP cameras: device discovery, media profiles and RTSP URIs, PTZ, imaging, events (PullPoint), analytics modules and rules with Profile M metadata, Profile G edge recordings, and device I/O.</Description>
    <!-- Terms someone would actually search nuget.org for, not a restatement of the title. -->
    <PackageTags>onvif;ip-camera;cctv;video-surveillance;ptz;rtsp;discovery;ws-discovery;profile-g;profile-m;analytics;soap</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Analytics service (ver20): analytics modules and rules, with cell layout resolved from the rule description or the optional options call. Profile M metadata configuration on the media service. Profile G: recording, search and replay. Device I/O: relay outputs and digital inputs. Camera reports HasAnalytics; CameraClockReading exposes the device clock offset.</PackageReleaseNotes>

    <!-- XML docs ship with the package so consumers get IntelliSense on the public API. CS1591
         ("missing XML comment") is suppressed rather than chased: most of the public surface is
         svcutil-generated Reference.cs, which carries no docs and is not ours to annotate. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- A build from a clean checkout produces byte-identical output, which is what lets SourceLink
         point at sources that provably match the binary. -->
    <Deterministic>true</Deterministic>
    <!-- RepositoryUrl+RepositoryType put the "Source repository" link (with the exact commit) on
         the nuget.org page; PackageProjectUrl is the separate "Project website" link at the top. -->
    <PackageProjectUrl>https://github.com/treealarm/OnvifLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/treealarm/OnvifLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink: lets a consumer step into this library's sources from their debugger instead of
         only following a link. The .NET 8 SDK ships the GitHub provider, so no package reference is
         needed — these switches are the whole setup. The symbol package travels with the .nupkg:
         `dotnet nuget push` picks up a matching .snupkg sitting next to it. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />
    <PackageReference Include="System.ServiceModel.Duplex" Version="6.0.*" />
    <PackageReference Include="System.ServiceModel.Federation" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Http" Version="8.*" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="8.*" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.*" />
    <PackageReference Include="System.ServiceModel.Security" Version="6.0.*" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>