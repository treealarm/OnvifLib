<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

    <PackageId>OnvifLib</PackageId>
    <Version>1.2.0</Version>
    <Authors>Danil Serov</Authors>
    <Company>TreeAlarm</Company>
    <Copyright>Copyright (c) TreeAlarm</Copyright>
    <Description>A modern .NET library for ONVIF-compliant IP cameras: device discovery, media profiles and RTSP URIs, OSD, PTZ with home and auxiliary commands, imaging with exposure, white balance, day/night and focus control, events (PullPoint with topic filters), device administration (users, network, NTP/DNS, time zone, scopes), analytics modules and rules with Profile M metadata, Profile G edge recordings, jobs and event search, and device I/O.</Description>
    <!-- Terms someone would actually search nuget.org for, not a restatement of the title. -->
    <PackageTags>onvif;ip-camera;cctv;video-surveillance;ptz;rtsp;discovery;ws-discovery;profile-g;profile-m;analytics;soap</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>1.2.0: Cameras that do not answer GetServices (ONVIF 1.x/2.0) are now reached through GetCapabilities (Camera.UsedCapabilitiesFallback says which). Events: GetEventProperties, GetServiceCapabilities, SetSynchronizationPoint and topic filters (EventService1.SetTopicFilterAsync). Imaging: IR cut filter, exposure, white balance, WDR, backlight compensation and focus configuration, plus focus moves and status. PTZ: home position, nodes, auxiliary commands and a speed for GotoPreset. Device administration on Camera: users, date/time mode and time zone, network interfaces, DNS, NTP, hostname, protocols, gateway and discovery scopes. Media: OSD and video source configurations. Profile G: recording options, creating recordings, tracks and jobs, job configuration and state, and FindEvents. OnvifImagingSettings, OnvifImagingOptions and OnvifProfileInfo gained optional trailing members — source-compatible, but consumers must recompile. Fixes: Media1 profiles now report the physical video source in VideoSourceToken (it was the configuration token, which Imaging rejects on cameras where the two differ; the configuration token is now VideoSourceConfigToken); SetTimeAsync keeps the camera time zone and DST flag instead of clearing them.</PackageReleaseNotes>

    <!-- XML docs ship with the package so consumers get IntelliSense on the public API. CS1591
         ("missing XML comment") is suppressed rather than chased: most of the public surface is
         svcutil-generated Reference.cs, which carries no docs and is not ours to annotate. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- A build from a clean checkout produces byte-identical output, which is what lets SourceLink
         point at sources that provably match the binary. -->
    <Deterministic>true</Deterministic>
    <!-- RepositoryUrl+RepositoryType put the "Source repository" link (with the exact commit) on
         the nuget.org page; PackageProjectUrl is the separate "Project website" link at the top. -->
    <PackageProjectUrl>https://github.com/treealarm/OnvifLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/treealarm/OnvifLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink: lets a consumer step into this library's sources from their debugger instead of
         only following a link. The .NET 10 SDK ships the GitHub provider, so no package reference is
         needed — these switches are the whole setup. The symbol package travels with the .nupkg:
         `dotnet nuget push` picks up a matching .snupkg sitting next to it. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="System.ServiceModel.Duplex" Version="6.0.*" />
    <PackageReference Include="System.ServiceModel.Federation" Version="10.*" />
    <PackageReference Include="System.ServiceModel.Http" Version="10.*" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="10.*" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="10.*" />
    <PackageReference Include="System.ServiceModel.Security" Version="6.0.*" />
    <!-- Transitive through System.ServiceModel.*, which still asks for 10.0.0 — a version NuGet
         audit flags with known high-severity advisories. Pinned here so the restored graph gets
         the patched build; drop this line once the WCF packages ask for it themselves. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <!-- This project sits at the repository root, so the SDK's default **/*.cs glob would
         compile the sample applications into the library itself. They are separate projects
         with their own csproj files and must stay out. -->
    <Compile Remove="samples/**" />
    <None Remove="samples/**" />
    <EmbeddedResource Remove="samples/**" />
  </ItemGroup>
</Project>